{
  "plan": "01_matriz-legal-periodicidad-docs",
  "version": 1,
  "enum_periodicidad": ["MENSUAL", "TRIMESTRAL", "SEMESTRAL", "ANUAL"],
  "numero_por_periodicidad": {
    "ANUAL": { "min": 1, "max": 1 },
    "SEMESTRAL": { "min": 1, "max": 2 },
    "TRIMESTRAL": { "min": 1, "max": 4 },
    "MENSUAL": { "min": 1, "max": 12 }
  },
  "tablas": {
    "matriz_legal_evaluacion": {
      "añade": {
        "periodicidad": "TEXT NOT NULL DEFAULT 'ANUAL' CHECK (periodicidad IN ('MENSUAL','TRIMESTRAL','SEMESTRAL','ANUAL'))",
        "numero_periodo": "SMALLINT NOT NULL DEFAULT 1"
      },
      "unique": "(empresa_id, componente_id, periodo, periodicidad, numero_periodo)",
      "nota": "periodo sigue siendo el AÑO. Filas previas quedan ANUAL/1 por DEFAULT."
    },
    "matriz_legal_documento": {
      "columnas": {
        "id": "UUID PK",
        "empresa_id": "UUID NOT NULL FK empresas",
        "periodo": "INTEGER NULL (año del corte; NULL = documento general)",
        "periodicidad": "TEXT NULL CHECK enum",
        "numero_periodo": "SMALLINT NULL",
        "nombre": "TEXT NOT NULL",
        "version": "TEXT NULL",
        "archivo_path": "TEXT NOT NULL",
        "archivo_nombre": "TEXT NOT NULL",
        "mime_type": "TEXT NULL",
        "tamano_bytes": "BIGINT NULL",
        "fecha_revision": "DATE NULL",
        "subido_por": "UUID NULL FK auth.users",
        "created_at": "TIMESTAMPTZ NOT NULL DEFAULT now()",
        "updated_at": "TIMESTAMPTZ NOT NULL DEFAULT now()"
      }
    }
  },
  "storage": {
    "bucket": "matriz-legal-docs",
    "public": false,
    "ruta": "{empresa_id}/{periodo}/{timestamp}_{archivo}",
    "policy": "storage.objects where bucket_id='matriz-legal-docs' AND (storage.foldername(name))[1] = get_my_empresa_id()::text"
  },
  "rpc": {
    "get_matriz_legal_resumen": {
      "firma_nueva": "(p_periodo INTEGER, p_periodicidad TEXT DEFAULT 'ANUAL', p_numero SMALLINT DEFAULT 1) RETURNS JSONB",
      "security": "INVOKER",
      "cambio": "DROP de la firma (INTEGER) y recrear; el LEFT JOIN filtra por periodo + periodicidad + numero_periodo",
      "shape_sin_cambios": "{ periodo, sgSst, ambiental } con pctCumple/pctEnProceso/pctNoCumple 0..1"
    }
  },
  "vectores_dorados": {
    "numeroValido": [
      { "periodicidad": "ANUAL", "n": 1, "esperado": true },
      { "periodicidad": "ANUAL", "n": 2, "esperado": false },
      { "periodicidad": "SEMESTRAL", "n": 2, "esperado": true },
      { "periodicidad": "SEMESTRAL", "n": 3, "esperado": false },
      { "periodicidad": "TRIMESTRAL", "n": 4, "esperado": true },
      { "periodicidad": "TRIMESTRAL", "n": 5, "esperado": false },
      { "periodicidad": "MENSUAL", "n": 12, "esperado": true },
      { "periodicidad": "MENSUAL", "n": 0, "esperado": false },
      { "periodicidad": "MENSUAL", "n": 13, "esperado": false }
    ],
    "etiquetaCorte": [
      { "periodo": 2026, "periodicidad": "ANUAL", "numero": 1, "esperado": "2026" },
      { "periodo": 2026, "periodicidad": "SEMESTRAL", "numero": 2, "esperado": "2.º semestre 2026" },
      { "periodo": 2026, "periodicidad": "TRIMESTRAL", "numero": 2, "esperado": "Q2 2026" },
      { "periodo": 2026, "periodicidad": "MENSUAL", "numero": 6, "esperado": "Jun 2026" }
    ]
  },
  "duenos": {
    "capa-datos": [
      "database/migrations/2026_11_11_01_matriz_legal_periodicidad.sql",
      "database/migrations/2026_11_11_02_matriz_legal_documentos.sql",
      "src/app/core/models/matriz-legal.model.ts"
    ],
    "cliente-web": [
      "src/app/core/services/matriz-legal.service.ts",
      "src/app/modules/matriz-legal/pages/matriz/matriz-legal.component.ts",
      "src/app/modules/matriz-legal/pages/matriz/matriz-legal.component.html",
      "src/app/modules/matriz-legal/pages/matriz/matriz-legal.component.scss",
      "src/app/core/models/matriz-legal.model.spec.ts"
    ]
  }
}
